{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teach-club",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },

  // The website itself (HTML, CSS, JS) lives in ./public.
  // Any URL that isn't a real file falls back to index.html so the app's own router can handle it.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The database, created with `npx wrangler d1 create teach-club-db`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teach-club-db",
      "database_id": "70536c2b-c8ed-4dae-b198-13d40df109b0",
      "migrations_dir": "migrations"
    }
  ]
}
